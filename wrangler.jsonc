{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "train-ticket-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat"],

  "kv_namespaces": [
    {
      "binding": "TRAIN_CACHE",
      "id": "83cd88789e984d70b3bb640b039b1906"
    }
  ],

  // Create these five secrets in ONE Cloudflare Secrets Store.
  // Replace STORE_ID with that store's ID. Each secret value can be
  // rotated independently in the Cloudflare dashboard without code changes.
  "secrets_store_secrets": [
    { "binding": "FIRECRAWL_KEY_1", "store_id": "5a4e63527a774cebb1885775e8228160", "secret_name": "FIRECRAWL_KEY_1" },
    { "binding": "FIRECRAWL_KEY_2", "store_id": "5a4e63527a774cebb1885775e8228160", "secret_name": "FIRECRAWL_KEY_2" },
    { "binding": "FIRECRAWL_KEY_3", "store_id": "5a4e63527a774cebb1885775e8228160", "secret_name": "FIRECRAWL_KEY_3" },
    { "binding": "FIRECRAWL_KEY_4", "store_id": "5a4e63527a774cebb1885775e8228160", "secret_name": "FIRECRAWL_KEY_4" },
    { "binding": "FIRECRAWL_KEY_5", "store_id": "5a4e63527a774cebb1885775e8228160", "secret_name": "FIRECRAWL_KEY_5" },
    { "binding": "FIRECRAWL_KEY_6", "store_id": "5a4e63527a774cebb1885775e8228160", "secret_name": "FIRECRAWL_KEY_6" }
  ],

  "observability": {
    "enabled": true
  }
}
