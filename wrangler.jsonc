{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "train-ticket-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat"],

  "kv_namespaces": [
    {
      "binding": "TRAIN_CACHE",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],

  // Create these five secrets in ONE Cloudflare Secrets Store.
  // Replace STORE_ID with that store's ID. Each secret value can be
  // rotated independently in the Cloudflare dashboard without code changes.
  "secrets_store_secrets": [
    { "binding": "FIRECRAWL_KEY_1", "store_id": "REPLACE_WITH_STORE_ID", "secret_name": "FIRECRAWL_KEY_1" },
    { "binding": "FIRECRAWL_KEY_2", "store_id": "REPLACE_WITH_STORE_ID", "secret_name": "FIRECRAWL_KEY_2" },
    { "binding": "FIRECRAWL_KEY_3", "store_id": "REPLACE_WITH_STORE_ID", "secret_name": "FIRECRAWL_KEY_3" },
    { "binding": "FIRECRAWL_KEY_4", "store_id": "REPLACE_WITH_STORE_ID", "secret_name": "FIRECRAWL_KEY_4" },
    { "binding": "FIRECRAWL_KEY_5", "store_id": "REPLACE_WITH_STORE_ID", "secret_name": "FIRECRAWL_KEY_5" }
  ],

  "observability": {
    "enabled": true
  }
}
